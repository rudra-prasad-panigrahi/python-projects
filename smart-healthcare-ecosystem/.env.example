# ============================================================

# Smart Healthcare Ecosystem

# Module 1 - Personal Health Gateway

# Development Environment Template

# ============================================================

# ------------------------------------------------------------

# Application

# ------------------------------------------------------------

APP_NAME=Smart Healthcare Ecosystem
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# Frontend

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_MSW=true
VITE_ENABLE_DEMO_MODE=true

# ------------------------------------------------------------

# Backend

# ------------------------------------------------------------

HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------

# Database

# ------------------------------------------------------------

POSTGRES_DB=smart_healthcare
POSTGRES_USER=healthcare_app
POSTGRES_PASSWORD=change-me-development-only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://healthcare_app:change-me-development-only@postgres:5432/smart_healthcare

# ------------------------------------------------------------

# Redis

# ------------------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

JWT_SECRET_KEY=replace-with-a-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
OAUTH_SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ------------------------------------------------------------

# CORS

# ------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------

# Storage

# ------------------------------------------------------------

STORAGE_PROVIDER=local

LOCAL_STORAGE_PATH=./storage

# Optional S3-compatible configuration for future deployment

S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# ------------------------------------------------------------

# AI

# ------------------------------------------------------------

AI_ENVIRONMENT=development

# Provider configuration should be supplied only in environments

# where external AI services are intentionally enabled.

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Embeddings / RAG

EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
VECTOR_STORE_PROVIDER=local

# ------------------------------------------------------------

# OCR / Document Processing

# ------------------------------------------------------------

OCR_PROVIDER=
OCR_API_KEY=

# ------------------------------------------------------------

# Notifications

# ------------------------------------------------------------

NOTIFICATION_PROVIDER=console

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

SMS_PROVIDER=
SMS_API_KEY=

# ------------------------------------------------------------

# Maps / Location

# ------------------------------------------------------------

MAP_PROVIDER=openstreetmap

MAPS_API_KEY=

# ------------------------------------------------------------

# Feature Flags

# ------------------------------------------------------------

FEATURE_AI_ASSISTANT=true
FEATURE_LAB_INTERPRETER=true
FEATURE_HEALTH_TRENDS=true
FEATURE_RISK_PREDICTION=false
FEATURE_WEARABLES=false
FEATURE_EXTERNAL_PROVIDER_CONNECTIONS=false

# ------------------------------------------------------------

# Observability

# ------------------------------------------------------------

LOG_LEVEL=INFO
ENABLE_REQUEST_ID=true

# Optional OpenTelemetry

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ------------------------------------------------------------

# Security

# ------------------------------------------------------------

RATE_LIMIT_ENABLED=true
AUDIT_LOG_ENABLED=true

# Never use development defaults in production.

BREAK_GLASS_ENABLED=false

# ------------------------------------------------------------

# Development Seed Data

# ------------------------------------------------------------

SEED_DEMO_DATA=true
SYNTHETIC_DATA_SEED=2026

# ------------------------------------------------------------

# Testing

# ------------------------------------------------------------

TEST_DATABASE_URL=postgresql+psycopg://healthcare_test:test@localhost:5433/smart_healthcare_test

# ------------------------------------------------------------

# Production Reminder

# ------------------------------------------------------------

# Do not copy this file directly into production.

# Create environment-specific secrets using the deployment

# secret-management mechanism.
