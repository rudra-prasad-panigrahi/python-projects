# ============================================================

# Smart Healthcare Ecosystem - Git Ignore

# ============================================================

# ------------------------------------------------------------

# Environment / Secrets

# ------------------------------------------------------------

.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
credentials/
.local/

# ------------------------------------------------------------

# OS / Editor

# ------------------------------------------------------------

.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# ------------------------------------------------------------

# Python

# ------------------------------------------------------------

**pycache**/
*.py[cod]
*$py.class
*.so

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.pyre/
.pytype/

pip-wheel-metadata/
dist/
build/
*.egg-info/

# Jupyter

.ipynb_checkpoints/

# ------------------------------------------------------------

# Node / Frontend

# ------------------------------------------------------------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/

dist/
build/
coverage/

*.tsbuildinfo

# Vite

.vite/

# Next.js if introduced later

.next/
out/

