# Test / E2E

# ------------------------------------------------------------

playwright-report/
test-results/
blob-report/
cypress/screenshots/
cypress/videos/

# ------------------------------------------------------------

# Database / Local Development

# ------------------------------------------------------------

*.sqlite
*.sqlite3
*.db
*.db-journal

postgres-data/
mysql-data/
redis-data/

# ------------------------------------------------------------

# Application Runtime

# ------------------------------------------------------------

logs/
*.log
tmp/
temp/
.cache/

# ------------------------------------------------------------

# Uploaded / Generated Files

# ------------------------------------------------------------

storage/uploads/*
storage/processed-documents/*
storage/thumbnails/*
!storage/uploads/.gitkeep
!storage/processed-documents/.gitkeep
!storage/thumbnails/.gitkeep

# ------------------------------------------------------------

# AI / ML Artifacts

# ------------------------------------------------------------

ai/model_artifacts/*
!ai/model_artifacts/.gitkeep

ai/personal/vector_store/chroma/*
ai/personal/vector_store/faiss/*

*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.safetensors
*.bin

# Experiment outputs

ai/experiments/runs/
mlruns/
wandb/
outputs/

# ------------------------------------------------------------

# Synthetic / Generated Data

# ------------------------------------------------------------

data/generated/*
!data/generated/.gitkeep

data/runtime/*
!data/runtime/.gitkeep

# Do not commit accidentally generated production-like data

*.parquet
*.feather

# ------------------------------------------------------------

# Docker

# ------------------------------------------------------------

docker-compose.override.yml

# ------------------------------------------------------------

# Security

# ------------------------------------------------------------

security/secrets/*
!security/secrets/.gitkeep

# Certificates generated locally

security/certificates/*
!security/certificates/.gitkeep

# ------------------------------------------------------------

# Terraform

# ------------------------------------------------------------

.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# ------------------------------------------------------------

# Deployment

# ------------------------------------------------------------

deployment/runtime/
deployment/generated/

# ------------------------------------------------------------

# Miscellaneous

# ------------------------------------------------------------

.DS_Store
*.bak
*.tmp
*.swp
*.orig
